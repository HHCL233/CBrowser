{
  "extends": "@electron-toolkit/tsconfig/tsconfig.web.json",
  "include": [
    "src/renderer/shell/src/env.d.ts",
    "src/renderer/shell/src/**/*",
    "src/renderer/shell/src/**/*.vue",
    "src/preload/*.d.ts"
  ],
  "compilerOptions": {
    "composite": true,
    "baseUrl": ".",
    "paths": {
      "@renderer/*": [
        "src/renderer/shell/src/*"
      ]
    },
    "types": ["chrome"]
  }
}
